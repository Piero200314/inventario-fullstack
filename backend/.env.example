# Plantilla sin credenciales. Conserva cualquier .env existente que funciona.
# Aiven: pega privadamente la URI de tu consola, sin el comando psql.
DB_DIALECT=postgres
DATABASE_URL="postgresql://USUARIO:CLAVE@SERVIDOR:PUERTO/defaultdb?sslmode=require"
DIRECT_DATABASE_URL="postgresql://USUARIO:CLAVE@SERVIDOR:PUERTO/defaultdb?sslmode=require"
DB_SSL=true
DB_SSL_CA_FILE=./certs/aiven-ca.pem
IMAGE_STORAGE=database
PORT=3006
FRONTEND_ORIGIN=http://localhost:5173
# configurar-seguridad.js genera JWT_SECRET si falta o está vacío.
JWT_SECRET=
JWT_EXPIRES_IN=1h
ALLOW_REGISTRATION=false
